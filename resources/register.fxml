
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<GridPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.RegisterController"
          alignment="CENTER" hgap="10" vgap="10">
    <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="Subscription Type:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <ComboBox fx:id="subscriptionBox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Button text="Register" onAction="#handleRegister" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
</GridPane>
